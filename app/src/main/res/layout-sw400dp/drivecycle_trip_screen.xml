<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mainmenu"
    android:layout_marginLeft="@dimen/activity_left_margin"
    android:animateLayoutChanges="true"
    android:layout_marginRight="@dimen/activity_left_margin"
    tools:context="com.velexsoft.checkengine.DriveCycleTripScreen">

    <LinearLayout
        android:id="@+id/buttonLinearLayout"
        android:orientation="horizontal"
        android:paddingTop="@dimen/activity_left_margin"
        android:paddingBottom="@dimen/activity_left_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4"
        >

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginRight="4dp"
            android:background="@drawable/button_selector"
            android:text="Pre-Test Check"
            android:onClick="displayRunReportData"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@+id/buttonRunTest"
            android:textColor="#000000" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:background="@drawable/button_selector"
            android:text="Start Trip"
            android:layout_weight="2"
            android:enabled="false"
            android:onClick="toggleGPSUpdates"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@+id/buttonStartTrip"
            android:textColor="#b7b7b7" />

    </LinearLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/listframe"
        android:background="@drawable/outlinedark"
        android:layout_height="150dp">

        <ListView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:id="@+id/listView"
            android:scrollbarAlwaysDrawHorizontalTrack="true"
            android:layout_gravity="center_horizontal"
            android:divider="#a5848484"
            android:dividerHeight="0.1dp"
            />

        <ProgressBar
            android:id="@+id/pb_loading_indicator"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:layout_height="48dp"
            android:layout_width="48dp"
            android:layout_gravity="left"
            android:visibility="invisible" />

    </FrameLayout>


    <LinearLayout
        android:layout_marginTop="8dp"
        android:id="@+id/myCheckLight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="4dp"
        android:visibility="invisible"
        android:weightSum="5"
        >

        <LinearLayout
            android:id="@+id/mygascoolant"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_weight="3"
            >

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_weight="2"
                android:layout_height="match_parent">

                <com.velexsoft.checkengine.speedviewlib.SpeedView
                    android:id="@+id/speedView1"
                    android:layout_width="match_parent"
                    android:padding="4dp"
                    android:paddingTop="8dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    app:sv_highSpeedColor="#f1bab2"
                    app:sv_indicatorColor="#a4a4a4"
                    app:sv_lowSpeedColor="#f1bab2"
                    app:sv_lowSpeedPercent="58"
                    app:sv_mediumSpeedColor="#e6ffd0"
                    app:sv_unit="C"
                    app:sv_indicatorWidth="3dp"
                    app:sv_speedometerWidth="10dp"
                    app:sv_speedTextPadding="6dp"
                    app:sv_tickPadding="12dp"
                    app:sv_mediumSpeedPercent="83"
                    app:sv_tickNumber="10"
                    app:sv_unitUnderSpeedText="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:text="Cool. Temp"
                    android:textColor="#000000"
                    android:layout_gravity="center_horizontal"
                    android:paddingBottom="60dp"
                    android:gravity="center"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:layout_height="match_parent" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_weight="2"
                android:layout_height="match_parent">

                <com.velexsoft.checkengine.speedviewlib.SpeedView
                    android:id="@+id/speedView2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:paddingTop="8dp"
                    app:sv_highSpeedColor="#f1bab2"
                    app:sv_indicatorColor="#a4a4a4"
                    app:sv_lowSpeedColor="#f1bab2"
                    app:sv_unit="%"
                    android:padding="4dp"
                    android:layout_weight="2"
                    app:sv_indicatorWidth="3dp"
                    app:sv_speedometerWidth="10dp"
                    app:sv_speedTextPadding="8dp"
                    app:sv_tickPadding="12dp"
                    app:sv_lowSpeedPercent="25"
                    app:sv_mediumSpeedColor="#e6ffd0"
                    app:sv_mediumSpeedPercent="75"
                    app:sv_tickNumber="10"
                    app:sv_unitUnderSpeedText="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:text="Fuel Tank"
                    android:textColor="#000000"
                    android:layout_gravity="center_horizontal"
                    android:paddingBottom="60dp"
                    android:gravity="center"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:layout_height="match_parent" />



            </FrameLayout>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/mygascoolant1"
            android:layout_width="match_parent"
            android:background="@drawable/outlinedark"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="2"
            android:visibility="invisible"
            >

            <com.velexsoft.checkengine.speedviewlib.SpeedView
                android:id="@+id/speedView3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:paddingTop="8dp"
                app:sv_highSpeedColor="#f1bab2"
                app:sv_indicatorColor="#a4a4a4"
                app:sv_lowSpeedColor="#f1bab2"
                app:sv_unit="Km/hr"
                android:padding="4dp"
                android:layout_weight="2"
                app:sv_indicatorWidth="5dp"
                app:sv_speedometerWidth="10dp"
                app:sv_speedTextPadding="8dp"
                app:sv_tickPadding="12dp"
                app:sv_lowSpeedPercent="40"
                app:sv_mediumSpeedColor="#e6ffd0"
                app:sv_mediumSpeedPercent="60"
                app:sv_tickNumber="10"
                app:sv_unitUnderSpeedText="true" />

            <TextView
                android:layout_width="match_parent"
                android:text="Speed"
                android:textColor="#000000"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="90dp"
                android:gravity="center"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_height="match_parent" />

            <ImageView
                android:layout_height="45dp"
                android:layout_width="60dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:layout_marginTop="30dp"
                android:padding="6dp"
                android:id="@+id/imagechklight"
                android:src="@drawable/checkengineok"
                />

            <TextView
                android:layout_width="match_parent"
                android:text=""
                android:id="@+id/distTravelled"
                android:textColor="#ba050a"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="120dp"
                android:gravity="center"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:layout_height="match_parent" />

        </FrameLayout>


    </LinearLayout>
</LinearLayout>