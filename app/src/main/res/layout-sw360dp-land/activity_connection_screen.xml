<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="4dp"
    tools:context="com.velexsoft.checkengine.ConnectionScreen">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/connscreennewland"
        android:layout_weight="5"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:paddingTop="8dp"
            android:padding="@dimen/activity_left_margin"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/pb_loading_indicator"
                android:layout_margin="4dp"
                android:layout_height="54dp"
                android:layout_width="54dp"
                android:layout_gravity="top"
                android:visibility="invisible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="0dp"
                android:text="Check Engine"
                android:textColor="#404040"
                android:textSize="38dp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:id="@+id/title1"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="@string/title2"
                android:textColor="#ffba050a"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:id="@+id/title2"
                />

            <View
                android:layout_height="240dp"
                android:layout_width="240dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:padding="4dp"
                android:id="@+id/image1"
                android:src="@drawable/device"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:paddingTop="140dp"
            android:layout_margin="24dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/dashboardmenu"
            android:orientation="vertical">

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/connectButton1Text"
            android:onClick="ConnButton"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@+id/buttonConnect"
            android:background="@drawable/button_gray_ripple_effects"
            android:textColor="#000000" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingTop="8dp"
            android:text="@string/connectButton2Text"
            android:onClick="goCheckCom"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:background="@drawable/button_gray_ripple_effects"
            android:id="@+id/buttonSite"
            android:textColor="#000000"
            />

        <CheckBox
            android:layout_width="match_parent"
            android:paddingTop="4dp"
            android:layout_marginTop="16dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:text="@string/checkboxoffline"
            android:visibility="invisible"
            android:onClick="checkEngineMAC"
            android:textColor="#ff292929"
            android:id="@+id/offline"
            android:layout_height="24dp"
            />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
