<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/mainmenu"
    tools:context="com.velexsoft.checkengine.MonitorsScreen">

    <ProgressBar
        android:id="@+id/pb_loading_indicator"
        android:layout_margin="16dp"
        android:layout_height="38dp"
        android:layout_width="38dp"
        android:layout_gravity="left"
        android:visibility="invisible" />

    <LinearLayout

        android:id="@+id/mainack"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        >

        <Spinner
            android:id="@+id/spinner1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/activity_horizontal_margin320"
            android:spinnerMode="dropdown" />

        <View   android:id="@+id/basic1Divider3"
            android:layout_height="0.1dp"
            android:layout_width="match_parent"
            android:background="#666666" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/activity_main_swipe_refresh_layout"
        android:layout_width="match_parent"
        android:paddingRight="@dimen/activity_horizontal_margin320"
        android:paddingLeft="@dimen/activity_horizontal_margin320"
        android:layout_height="wrap_content">

        <ListView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/activity_horizontal_margin320"
            android:id="@+id/listView"
            android:fastScrollEnabled="true"
            android:divider="#a5848484"
            android:dividerHeight="0.1dp"
            />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>
</LinearLayout>
