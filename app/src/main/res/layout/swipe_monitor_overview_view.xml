<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/myRelativeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/scrollView" >

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin">

            <TextView android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textMonInfoQuestion"
                android:gravity="left"
                android:text="What are Monitors?"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#ba050a"
                android:textStyle="bold"
                android:layout_centerInParent="true"/>

            <TextView android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textMonInfo"
                android:gravity="left"
                android:paddingTop="@dimen/activity_horizontal_margin"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:text=""
                android:textColor="@android:color/background_dark"
                android:background="@drawable/outlinedark"
                android:layout_centerInParent="true"/>

            <TextView android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textMonTypesQuestion"
                android:gravity="left"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:text="What Monitors Types are available?"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#ba050a"

                android:textStyle="bold"
                android:layout_centerInParent="true"/>

            <TextView android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textMonTypes"
                android:gravity="left"
                android:paddingTop="@dimen/activity_horizontal_margin"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:text=""
                android:textColor="@android:color/background_dark"
                android:background="@drawable/outlinedark"
                android:layout_centerInParent="true"/>


            <TextView android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textMonTypesProcess"
                android:gravity="left"
                android:text="What are Monitors Processes?"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="#ba050a"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:textStyle="bold"
                android:layout_centerInParent="true"/>

            <TextView android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textMonProcess"
                android:paddingTop="@dimen/activity_horizontal_margin"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:gravity="left"
                android:text="public profiles View"
                android:textColor="@android:color/background_dark"
                android:background="@drawable/outlinedark"
                android:layout_centerInParent="true"/>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>