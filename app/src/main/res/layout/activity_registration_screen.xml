<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="3dp"
    tools:context="com.velexsoft.checkengine.RegistrationScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:paddingLeft="@dimen/activity_left_margin"
        android:paddingTop="36dp"
        android:paddingRight="@dimen/activity_left_margin"
        android:background="@drawable/connscreennew"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:text="Check Engine"
            android:textColor="#404040"
            android:textSize="36dp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:id="@+id/title1"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="@string/title2"
            android:textColor="#ffba050a"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:gravity="center_horizontal"
            android:id="@+id/title2"
            />

        <FrameLayout
            android:layout_width="match_parent"
            android:id="@+id/fragment_output"
            android:visibility="visible"
            android:layout_height="match_parent">

            <fragment
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                class="com.velexsoft.checkengine.EnterSerialFragments"
                android:id="@+id/fragment"/>

        </FrameLayout>

    </LinearLayout>


</LinearLayout>




