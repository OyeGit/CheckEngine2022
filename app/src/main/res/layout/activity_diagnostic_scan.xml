<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mainmenu"
    android:orientation="vertical"
    tools:context="com.velexsoft.checkengine.DiagnosticScan">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingRight="18dp"
            android:paddingLeft="18dp"
            android:weightSum="10"
            android:background="#bfececec"
            android:gravity="center"
            android:layout_gravity="center">

            <ImageView
                android:layout_height="34dp"
                android:layout_width="48dp"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:padding="6dp"
                android:layout_weight="2"
                android:onClick="onClickEngLight"
                android:id="@+id/image1"
                android:src="@drawable/checkengineok"
                />

            <View   android:id="@+id/title11Divider"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="12dp"
                android:layout_width="0.1dp"
                android:background="#585858" />

            <ImageView
                android:layout_height="34dp"
                android:layout_width="48dp"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:padding="6dp"
                android:layout_weight="2"
                android:onClick="onClickEngineOilTemp"
                android:id="@+id/image2"
                android:src="@drawable/engineoiltempok"
                />

            <View   android:id="@+id/title6Divider"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="12dp"
                android:layout_width="0.1dp"
                android:background="#585858" />

            <ImageView
                android:layout_height="34dp"
                android:layout_width="48dp"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:padding="6dp"
                android:layout_weight="2"
                android:onClick="onClickCoolTemp"
                android:id="@+id/image3"
                android:src="@drawable/engoiltempok"
                />

            <View   android:id="@+id/title12Divider"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="12dp"
                android:layout_width="0.1dp"
                android:background="#585858" />

            <ImageView
                android:layout_height="34dp"
                android:layout_width="48dp"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:padding="6dp"
                android:layout_weight="2"
                android:onClick="onClickBattery"
                android:id="@+id/image4"
                android:src="@drawable/batteryok"
                />

            <View   android:id="@+id/title13Divider"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="12dp"
                android:layout_width="0.1dp"
                android:background="#585858" />

            <ImageView
                android:layout_height="34dp"
                android:layout_width="48dp"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:padding="6dp"
                android:layout_weight="2"
                android:onClick="onClickFuelTank"
                android:id="@+id/image5"
                android:src="@drawable/gastankok"
                />

        </LinearLayout>

        <View   android:id="@+id/basic1Divider2"
            android:layout_height="0.1dp"
            android:layout_width="match_parent"
            android:background="#666666" />

        <FrameLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_margin="4dp"
            android:background="@drawable/outlinedark"
            android:layout_height="wrap_content">

            <ProgressBar
                android:id="@+id/pb_loading_indicator"
                android:paddingLeft="6dp"
                android:paddingTop="6dp"
                android:layout_height="40dp"
                android:layout_width="40dp"
                android:layout_gravity="left"
                android:visibility="invisible" />

            <Spinner
                android:id="@+id/spinner1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:spinnerMode="dropdown" />

        </FrameLayout>

        <View   android:id="@+id/basic1Divider3"
            android:layout_height="0.1dp"
            android:layout_width="match_parent"
            android:background="#666666" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/activity_main_swipe_refresh_layout"
            android:layout_width="match_parent"
            android:paddingTop="12dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_height="wrap_content">

            <ListView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/listView"
                android:fastScrollEnabled="true"
                android:divider="#a5848484"
                android:dividerHeight="0.1dp"
                />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>


</LinearLayout>
