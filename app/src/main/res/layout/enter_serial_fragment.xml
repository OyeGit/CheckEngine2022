<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/myRelativeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:id="@+id/myLinearLayout"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/dashboardmenu"
        android:visibility="visible"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/pb_loading_indicator"
            android:layout_marginLeft="16dp"
            android:layout_height="42dp"
            android:layout_width="42dp"
            android:layout_gravity="left"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:background="@drawable/outlinedarker"
            android:visibility="visible"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="Enter serial number"
                android:textColor="#353535"
                android:id="@+id/instruction"
                />

            <View   android:id="@+id/title12Divider"
                android:layout_height="0.1dp"
                android:layout_marginBottom="@dimen/activity_horizontal_margin"
                android:layout_width="wrap_content"
                android:background="#585858" />

            <EditText
                android:id="@+id/vSerialNumber"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:paddingTop="12dp"
                android:maxLength="8"
                android:singleLine="true"
                android:layout_gravity="center"
                android:inputType="number"
                android:digits="1234567890"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#1d1d1d"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:background="#efefef"
                android:textColorHint="#c6c6c6"
                android:hint="Serial Number"
                />

            <View   android:id="@+id/title13Divider"
                android:layout_height="0.1dp"
                android:layout_marginTop="@dimen/activity_horizontal_margin"
                android:layout_width="wrap_content"
                android:background="#585858" />

            <Button
                android:id="@+id/activate"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="4dp"
                android:layout_gravity="center"
                android:text="Activate"
                android:textStyle="bold"
                android:background="@drawable/button_gray_ripple_effects"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:onClick="onbuttonClicked"
                />

            <View   android:id="@+id/title14Divider"
                android:layout_height="0.1dp"
                android:layout_marginTop="@dimen/activity_horizontal_margin"
                android:layout_width="wrap_content"
                android:background="#585858" />

            <TextView
                android:id="@+id/linkText"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:text="www.checkengine.me"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
               />

        </LinearLayout>

    </LinearLayout>


</LinearLayout>